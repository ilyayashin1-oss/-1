  <script>
    (function() {
      'use strict';

      // ==================== Константы ====================
      const LS_TASKS = 'tasks_pwa_v3';
      const LS_CATS = 'cats_pwa_v3';
      const LS_THEME = 'tasks_theme';
      const LS_SOUND = 'tasks_sound_enabled';

      const DEFAULT_CATS = [
        { id: 'work', name: 'Работа', color: '#3b82f6' },
        { id: 'home', name: 'Дом', color: '#10b981' },
        { id: 'personal', name: 'Личное', color: '#f59e0b' },
        { id: 'shopping', name: 'Покупки', color: '#ec4899' }
      ];

      // ==================== Состояние ====================
      let tasks = [];
      let categories = [];
      let currentFilter = 'all';
      let currentCategory = 'all';
      let currentRepeat = 'none';
      let reminderTimers = {};        // id -> timeout
      let notifiedTasks = new Set();  // id:occurrence -> true
      let swRegistration = null;
      let swReady = false;
      let soundEnabled = true;

      // ==================== DOM ====================
      const $ = id => document.getElementById(id);
      const taskInput = $('taskInput');
      const reminderInput = $('reminderInput');
      const categorySelect = $('categorySelect');
      const addBtn = $('addBtn');
      const taskList = $('taskList');
      const filters = $('filters');
      const counter = $('counter');
      const themeToggle = $('themeToggle');
      const toast = $('toast');
      const banners = $('banners');
      const repeatRow = $('repeatRow');
      const categoriesBar = $('categoriesBar');
      const categoriesBtn = $('categoriesBtn');
      const catModal = $('catModal');
      const closeCatModal = $('closeCatModal');
      const catList = $('catList');
      const newCatName = $('newCatName');
      const newCatColor = $('newCatColor');
      const addCatBtn = $('addCatBtn');

      // ==================== Утилиты ====================
      function genId() {
        return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      }

      function escapeHtml(str) {
        const div = document.createElement('div');
