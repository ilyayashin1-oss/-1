<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#0f172a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Задачник">
  <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'><rect width='180' height='180' rx='40' fill='%233b82f6'/><text x='90' y='125' font-size='100' text-anchor='middle'>📋</text></svg>">
  <title>Задачник PWA</title>
  <style>
    :root {
      --bg: #f5f7fa;
      --card: #ffffff;
      --text: #1e293b;
      --text-muted: #94a3b8;
      --input-bg: #f8fafc;
      --border: #e2e8f0;
      --item-bg: #f8fafc;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --danger: #ef4444;
      --danger-bg: #fee2e2;
      --shadow: rgba(0, 0, 0, 0.08);
      --filter-bg: #f1f5f9;
      --filter-text: #64748b;
      --success: #10b981;
    }

    [data-theme="dark"] {
      --bg: #0f172a;
      --card: #1e293b;
      --text: #e2e8f0;
      --text-muted: #64748b;
      --input-bg: #0f172a;
      --border: #334155;
      --item-bg: #0f172a;
      --primary: #3b82f6;
      --primary-hover: #60a5fa;
      --danger: #f87171;
      --danger-bg: #7f1d1d;
      --shadow: rgba(0, 0, 0, 0.4);
      --filter-bg: #334155;
      --filter-text: #94a3b8;
      --success: #34d399;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: var(--bg);
      display: flex;
      justify-content: center;
      min-height: 100vh;
      padding: 12px;
      padding-top: max(12px, env(safe-area-inset-top));
      padding-bottom: max(12px, env(safe-area-inset-bottom));
      transition: background 0.3s;
    }

    .app {
      width: 100%;
      max-width: 480px;
      background: var(--card);
      border-radius: 24px;
      box-shadow: 0 8px 24px var(--shadow);
      padding: 20px 16px;
      display: flex;
      flex-direction: column;
      height: fit-content;
      max-height: calc(100vh - 24px);
      transition: background 0.3s;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      gap: 8px;
    }

    h1 {
      font-size: 24px;
      font-weight: 600;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .header-actions {
      display: flex;
      gap: 6px;
    }

    .icon-btn {
      background: var(--filter-bg);
      border: none;
      width: 42px;
      height: 42px;
      border-radius: 14px;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, transform 0.1s;
      flex-shrink: 0;
      color: var(--text);
    }

    .icon-btn:active {
      transform: scale(0.92);
    }

    .icon-btn.active {
      background: var(--primary);
      color: white;
    }

    .input-row {
      display: flex;
      gap: 8px;
      margin-bottom: 10px;
    }

    .input-row input[type="text"] {
      flex: 1;
      padding: 14px 16px;
      border: 2px solid var(--border);
      border-radius: 16px;
      font-size: 16px;
      outline: none;
      transition: border-color 0.2s, background 0.3s;
      background: var(--input-bg);
      color: var(--text);
      min-width: 0;
    }

    .input-row input[type="text"]:focus {
      border-color: var(--primary);
      background: var(--card);
    }

    .input-row input[type="text"]::placeholder {
      color: var(--text-muted);
    }

    .input-row button.add {
      width: 56px;
      height: 56px;
      border: none;
      background: var(--primary);
      color: white;
      font-size: 28px;
      border-radius: 16px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, transform 0.1s;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .input-row button.add:active {
      transform: scale(0.94);
      background: var(--primary-hover);
    }

    .meta-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .meta-row input[type="datetime-local"] {
      flex: 1;
      padding: 10px 12px;
      border: 2px solid var(--border);
      border-radius: 12px;
      font-size: 14px;
      background: var(--input-bg);
      color: var(--text);
      outline: none;
      min-width: 140px;
      transition: border-color 0.2s;
      font-family: inherit;
    }

    .meta-row input[type="datetime-local"]:focus {
      border-color: var(--primary);
    }

    [data-theme="dark"] .meta-row input[type="datetime-local"]::-webkit-calendar-picker-indicator {
      filter: invert(1);
    }

    .meta-row select {
      padding: 10px 12px;
      border: 2px solid var(--border);
      border-radius: 12px;
      font-size: 14px;
      background: var(--input-bg);
      color: var(--text);
      outline: none;
      cursor: pointer;
      min-width: 0;
      flex: 1;
      font-family: inherit;
    }

    .meta-row select:focus {
      border-color: var(--primary);
    }

    .repeat-row {
      display: flex;
      gap: 6px;
      margin-bottom: 16px;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .repeat-row::-webkit-scrollbar { display: none; }

    .repeat-row button {
      padding: 8px 14px;
      border: 2px solid var(--border);
      background: var(--input-bg);
      color: var(--text-muted);
      font-size: 13px;
      font-weight: 500;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .repeat-row button.active {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
    }

    .filters {
      display: flex;
      gap: 6px;
      margin-bottom: 10px;
    }

    .filters button {
      flex: 1;
      padding: 8px 0;
      border: none;
      background: var(--filter-bg);
      color: var(--filter-text);
      font-size: 14px;
      font-weight: 500;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .filters button.active {
      background: var(--primary);
      color: white;
      box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
    }

    .categories {
      display: flex;
      gap: 6px;
      margin-bottom: 14px;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    .categories::-webkit-scrollbar { display: none; }

    .cat-chip {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 500;
      white-space: nowrap;
      cursor: pointer;
      border: 2px solid transparent;
      background: var(--filter-bg);
      color: var(--filter-text);
      transition: all 0.2s;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .cat-chip.active {
      border-color: currentColor;
    }

    .cat-chip .cat-count {
      background: rgba(255,255,255,0.25);
      padding: 1px 6px;
      border-radius: 10px;
      font-size: 11px;
    }

    .task-list {
      list-style: none;
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-right: 4px;
      min-height: 80px;
    }

    .task-list::-webkit-scrollbar {
      width: 4px;
    }

    .task-list::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 10px;
    }

    .task-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 14px 12px;
      background: var(--item-bg);
      border-radius: 14px;
      transition: background 0.2s;
      animation: fadeIn 0.25s ease;
      position: relative;
      overflow: hidden;
    }

    .task-item::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: var(--cat-color, transparent);
      border-radius: 4px 0 0 4px;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .task-item.done {
      opacity: 0.55;
    }

    .task-item.done .task-text {
      text-decoration: line-through;
      color: var(--text-muted);
    }

    .checkbox {
      width: 24px;
      height: 24px;
      border: 2px solid var(--border);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: all 0.2s;
      background: var(--card);
      margin-top: 1px;
    }

    .checkbox.checked {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
    }

    .checkbox.checked::after {
      content: '✓';
      font-size: 15px;
      font-weight: 700;
      color: white;
    }

    .task-content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .task-text {
      font-size: 16px;
      color: var(--text);
      word-break: break-word;
      line-height: 1.3;
    }

    .task-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }

    .task-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 8px;
      background: var(--filter-bg);
      color: var(--text-muted);
      transition: all 0.2s;
      white-space: nowrap;
    }

    .task-badge.overdue {
      color: var(--danger);
      background: var(--danger-bg);
      font-weight: 600;
    }

    .task-badge.future {
      color: var(--primary);
    }

    .task-badge.repeat {
      color: var(--success);
    }

    .task-badge.category {
      color: white;
      font-weight: 500;
    }

    .delete-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 20px;
      cursor: pointer;
      padding: 4px 6px;
      border-radius: 8px;
      transition: color 0.2s, background 0.2s;
      flex-shrink: 0;
      line-height: 1;
    }

    .delete-btn:active {
      color: var(--danger);
      background: var(--danger-bg);
    }

    .empty-state {
      text-align: center;
      padding: 40px 16px;
      color: var(--text-muted);
      font-size: 15px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      list-style: none;
    }

    .empty-state span {
      font-size: 40px;
    }

    .counter {
      text-align: center;
      color: var(--text-muted);
      font-size: 13px;
      margin-top: 12px;
      padding-top: 8px;
      border-top: 1px solid var(--border);
    }

    .toast {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: var(--card);
      color: var(--text);
      padding: 12px 20px;
      border-radius: 14px;
      box-shadow: 0 8px 24px var(--shadow);
      font-size: 14px;
      font-weight: 500;
      opacity: 0;
      transition: transform 0.3s, opacity 0.3s;
      pointer-events: none;
      z-index: 1000;
      border: 1px solid var(--border);
      max-width: 90vw;
      text-align: center;
    }

    .toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .banner {
      background: var(--filter-bg);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 13px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      justify-content: space-between;
      border: 1px solid var(--border);
      animation: fadeIn 0.3s ease;
    }

    .banner button {
      background: var(--primary);
      color: white;
      border: none;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      flex-shrink: 0;
    }

    .banner button.ghost {
      background: transparent;
      color: var(--text-muted);
      padding: 6px;
    }

    /* Модальное окно категорий */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      display: none;
      align-items: flex-end;
      justify-content: center;
      z-index: 999;
      animation: fadeIn 0.2s ease;
    }

    .modal-backdrop.show {
      display: flex;
    }

    .modal {
      background: var(--card);
      width: 100%;
      max-width: 480px;
      border-radius: 24px 24px 0 0;
      padding: 20px 16px;
      padding-bottom: max(20px, env(safe-area-inset-bottom));
      animation: slideUp 0.3s ease;
      max-height: 85vh;
      overflow-y: auto;
    }

    @keyframes slideUp {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }

    .modal h2 {
      color: var(--text);
      font-size: 20px;
      margin-bottom: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .cat-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 16px;
    }

    .cat-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      background: var(--item-bg);
      border-radius: 12px;
    }

    .cat-color-dot {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .cat-name {
      flex: 1;
      color: var(--text);
      font-size: 15px;
    }

    .cat-add-row {
      display: flex;
      gap: 8px;
      align-items: center;
      padding: 8px 0;
    }

    .cat-add-row input[type="text"] {
      flex: 1;
      padding: 10px 12px;
      border: 2px solid var(--border);
      border-radius: 12px;
      font-size: 15px;
      background: var(--input-bg);
      color: var(--text);
      outline: none;
      min-width: 0;
    }

    .cat-add-row input[type="color"] {
      width: 44px;
      height: 44px;
      border: 2px solid var(--border);
      border-radius: 12px;
      background: var(--input-bg);
      cursor: pointer;
      padding: 2px;
      flex-shrink: 0;
    }

    .cat-add-row button {
      background: var(--primary);
      color: white;
      border: none;
      padding: 10px 16px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      flex-shrink: 0;
    }

    .modal-close {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 24px;
      cursor: pointer;
      padding: 0 6px;
      line-height: 1;
    }

    @media (max-width: 380px) {
      .app { padding: 14px 10px; }
      h1 { font-size: 20px; }
      .input-row input[type="text"] { padding: 12px; font-size: 15px; }
      .input-row button.add { width: 50px; height: 50px; font-size: 24px; }
      .task-text { font-size: 15px; }
      .icon-btn { width: 38px; height: 38px; font-size: 18px; }
    }
  </style>
</head>
<body>
  <div class="app">
    <div class="header">
      <h1>📋 Задачник</h1>
      <div class="header-actions">
        <button class="icon-btn" id="categoriesBtn" aria-label="Категории" title="Категории">🏷️</button>
        <button class="icon-btn" id="themeToggle" aria-label="Тема">🌙</button>
      </div>
    </div>

    <div id="banners"></div>

    <div class="input-row">
      <input type="text" id="taskInput" placeholder="Новая задача..." maxlength="120" autocomplete="off">
      <button class="add" id="addBtn" aria-label="Добавить">+</button>
    </div>

    <div class="meta-row">
      <input type="datetime-local" id="reminderInput" title="Напоминание">
      <select id="categorySelect" title="Категория">
        <option value="">Без категории</option>
      </select>
    </div>

    <div class="repeat-row" id="repeatRow">
      <button data-repeat="none" class="active">🚫 Без повтора</button>
      <button data-repeat="daily">📅 Ежедневно</button>
      <button data-repeat="weekly">📆 Еженедельно</button>
      <button data-repeat="weekdays">💼 По будням</button>
    </div>

    <div class="filters" id="filters">
      <button data-filter="all" class="active">Все</button>
      <button data-filter="active">Активные</button>
      <button data-filter="done">Выполненные</button>
    </div>

    <div class="categories" id="categoriesBar"></div>

    <ul class="task-list" id="taskList"></ul>

    <div class="counter" id="counter"></div>
  </div>

  <!-- Модалка категорий -->
  <div class="modal-backdrop" id="catModal">
    <div class="modal">
      <h2>
        🏷️ Категории
        <button class="modal-close" id="closeCatModal">✕</button>
      </h2>
      <div class="cat-list" id="catList"></div>
      <div class="cat-add-row">
        <input type="color" id="newCatColor" value="#3b82f6">
        <input type="text" id="newCatName" placeholder="Название..." maxlength="20">
        <button id="addCatBtn">+</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    (function() {
      'use strict';

      // ==================== Константы ====================
      const LS_TASKS = 'tasks_pwa_v3';
      const LS_CATS = 'cats_pwa_v3';
      const LS_THEME = 'tasks_theme';
      const LS_SOUND = 'tasks_sound_enabled';

      const DEFAULT_CATS = [
        { id: 'work', name: 'Работа', color: '#3b82f6' },
        { id: 'home', name: 'Дом', color: '#10b981' },
        { id: 'personal', name: 'Личное', color: '#f59e0b' },
        { id: 'shopping', name: 'Покупки', color: '#ec4899' }
      ];

      // ==================== Состояние ====================
      let tasks = [];
      let categories = [];
      let currentFilter = 'all';
      let currentCategory = 'all';
      let currentRepeat = 'none';
      let reminderTimers = {};        // id -> timeout
      let notifiedTasks = new Set();  // id:occurrence -> true
      let swRegistration = null;
      let swReady = false;
      let soundEnabled = true;

      // ==================== DOM ====================
      const $ = id => document.getElementById(id);
      const taskInput = $('taskInput');
      const reminderInput = $('reminderInput');
      const categorySelect = $('categorySelect');
      const addBtn = $('addBtn');
      const taskList = $('taskList');
      const filters = $('filters');
      const counter = $('counter');
      const themeToggle = $('themeToggle');
      const toast = $('toast');
      const banners = $('banners');
      const repeatRow = $('repeatRow');
      const categoriesBar = $('categoriesBar');
      const categoriesBtn = $('categoriesBtn');
      const catModal = $('catModal');
      const closeCatModal = $('closeCatModal');
      const catList = $('catList');
      const newCatName = $('newCatName');
      const newCatColor = $('newCatColor');
      const addCatBtn = $('addCatBtn');

      // ==================== Утилиты ====================
      function genId() {
        return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      }

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      function hexToRgba(hex, alpha) {
        const h = hex.replace('#', '');
        const r = parseInt(h.substr(0, 2), 16);
        const g = parseInt(h.substr(2, 2), 16);
        const b = parseInt(h.substr(4, 2), 16);
        return `rgba(${r},${g},${b},${alpha})`;
      }

      let toastTimer
